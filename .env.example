# PostgreSQL connection used by both the API and Alembic migrations.
# Replace the placeholders below with your actual database details:
#   username: database role/user
#   password: that user's password (URL-encode special characters)
#   host: localhost for a database running on this computer
#   port: 5432 by default
#   database_name: the database you created or restored
# These components are combined into DATABASE_URL; separate DB_* fields are not read.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
AUTH_COOKIE_SECURE=false
MAX_REQUEST_BODY_BYTES=20971520
MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RAZORPAY_WEBHOOK_SECRET=replace-with-dashboard-webhook-secret
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
FRONTEND_URL
FRONTEND_PUBLIC_URL
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET

CLOUDINARY CONFIGURATION
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET

# RAZ0RPAY CONFIGURATION
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET
ORDER_TAX_PERCENT=18
# MAIL SERVER CONFIGURATION

SMTP_HOST
SMTP_PORT
SMTP_USERNAME
SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply.rms.110@gmail.com
SMTP_USE_TLS

# DATABASE CONFIGURATION
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinebook
